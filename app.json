{
  "expo": {
    "name": "Josan Logistics",
    "slug": "josan-logistics-customer",
    "scheme": "josancustomer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.josanlogistics.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "Josan Logistics needs camera access to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "Josan Logistics needs photo library access to update your profile photo."
      }
    },
    "android": {
      "package": "com.josanlogistics.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F77F28"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Josan Logistics to access your photos to set a profile picture."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
